/abstract/main.tex
/abstract/main.pdf
/_NLP_2026__Mechanistic_Interp_Collapse_Project1_brife.pdf
/NeurIPS_2024_checklist/
__MACOSX/

# LaTeX build intermediates; keep the reviewed PDF
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.out

# Local credentials and environment settings
.env
.env.*
!.env.example
!.env.sample

# Machine-specific editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Keep source, tests, configuration templates, Markdown reports, and deliberate
