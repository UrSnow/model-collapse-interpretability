*.egg-info/

# Generated presentation previews
/Experiments/presentations/.build/

# The historical deck remains local.
/Experiments/presentations/*.pptx

# Third-party course materials and unapproved contribution drafts stay local.
/Experiments/references/
/Experiments/past_drafts/
/Experiments/writing/
/submission/PRELIMINARY_CONTRIBUTION_STATEMENT.tex
/submission/PRELIMINARY_CONTRIBUTION_STATEMENT.pdf
