*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Local virtual environments
.venv/
.venv-wsl/
.venv-*/
venv/
env/

